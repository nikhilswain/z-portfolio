---
import BlogLayout from "@/layouts/BlogLayout.astro";
import PostList from "@/components/blog/PostList.astro";
import MediumList from "@/components/blog/MediumList.astro";
import { getBlogPosts } from "@/lib/blog/collection";
import { BLOG_DESCRIPTION, BLOG_TAGLINE, blogJsonLd } from "@/lib/blog/seo";
import { buildPostTree } from "@/lib/blog/tree";

const posts = await getBlogPosts();
const tree = buildPostTree(posts);
---

<BlogLayout
  title="Blog — Nikhil Kumar Swain"
  description={BLOG_DESCRIPTION}
  jsonLd={[blogJsonLd(posts)]}
  current="blog"
>
  <div class="blog-index">
    <header class="blog-index__header">
      <h1>Blog</h1>
      <p class="blog-index__lead">{BLOG_TAGLINE}</p>
      <a class="blog-index__rss" href="/blog/rss.xml">RSS feed</a>
    </header>
    {tree.length > 0 ? <PostList tree={tree} /> : <p class="blog-index__empty">First articles are on the way.</p>}
    <MediumList />
  </div>
</BlogLayout>
