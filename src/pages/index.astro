---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Hero from "@/components/home/Hero.astro";
import SectionHeading from "@/components/home/SectionHeading.astro";
import ProjectShowcase from "@/components/home/ProjectShowcase.astro";
import ProjectIndex from "@/components/home/ProjectIndex.astro";
import Experience from "@/components/home/Experience.astro";
import Playground from "@/components/home/Playground.astro";
import LatestWriting from "@/components/home/LatestWriting.astro";
import OffTheClock from "@/components/home/OffTheClock.astro";
import { PERSON } from "@/data/profile";
---

<SiteLayout
  title="Nikhil Kumar Swain — Frontend Developer"
  description={PERSON.summary}
  type="profile"
>
  <div class="home">
    <Hero />
    <div class="home-sections" data-sections>
      <section aria-labelledby="work" class="home-section" data-section="work">
        <SectionHeading eyebrow="Selected work" title="Things I've built" id="work" />
        <ProjectShowcase />
        <ProjectIndex />
      </section>
      <section aria-labelledby="experience" class="home-section" data-section="experience">
        <SectionHeading eyebrow="Experience" title="Where I've worked" id="experience" />
        <Experience />
      </section>
      <section aria-labelledby="playground" class="home-section" data-section="playground">
        <SectionHeading eyebrow="Playground" title="Small things to poke at" id="playground" />
        <Playground />
      </section>
      <section aria-labelledby="writing" class="home-section" data-section="writing">
        <SectionHeading eyebrow="Writing" title="Latest from the blog" id="writing" />
        <LatestWriting />
      </section>
      <section aria-labelledby="off-the-clock" class="home-section" data-section="off-the-clock">
        <SectionHeading eyebrow="Off the clock" title="What I'm playing and listening to" id="off-the-clock" />
        <OffTheClock />
      </section>
    </div>
    <p class="layout-note" hidden>You rearranged this page — it stays that way in this browser. <button type="button" data-layout-reset>Reset to Nikhil's layout</button></p>
  </div>

  <script is:inline>
    try {
      const wrapper = document.querySelector("[data-sections]");
      const saved = JSON.parse(localStorage.getItem("zerro-home-order") || "[]");
      if (wrapper && Array.isArray(saved)) {
        const sections = Array.from(wrapper.children);
        const byId = new Map(sections.map((s) => [s.getAttribute("data-section"), s]));
        const placed = new Set();
        for (const id of saved) {
          const section = byId.get(id);
          if (section) {
            wrapper.append(section);
            placed.add(section);
          }
        }
        for (const section of sections) {
          if (!placed.has(section)) wrapper.append(section);
        }
      }
    } catch {}
  </script>

  <script>
    import { initLayoutOrder } from "@/components/home/layout-order";
    initLayoutOrder();
  </script>
</SiteLayout>

<style>
  .home {
    max-width: var(--blog-index-width);
    margin-inline: auto;
    padding: var(--blog-space-8) var(--blog-page-pad);
  }

  .home-section {
    margin-top: var(--blog-space-9);
  }

  .layout-note {
    margin-top: var(--blog-space-5);
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-fg-muted);
  }

  .layout-note button {
    font: inherit;
    color: var(--blog-accent);
    cursor: pointer;
  }

  .layout-note button:hover {
    text-decoration: underline;
  }
</style>

<style is:global>
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .home .reveal {
        animation: reveal linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 40%;
      }
    }
  }

  @keyframes reveal {
    from {
      opacity: 0;
      translate: 0 16px;
    }
  }

  .home .home__links a,
  .home .home__more {
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color 200ms ease-out;
  }

  .home .home__links a:hover,
  .home .home__links a:focus-visible,
  .home .home__more:hover,
  .home .home__more:focus-visible {
    text-decoration-color: currentColor;
  }

  .home .home__more {
    display: inline-block;
    margin-top: var(--blog-space-5);
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-accent);
  }

  .home .home__more span {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .home .home__more span {
      transition: translate 200ms ease-out;
    }

    .home .home__more:hover span,
    .home .home__more:focus-visible span {
      translate: 3px 0;
    }
  }
</style>
