---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import { PortfolioRoot } from '@/components/portfolio-root';
import { getBlogPosts } from '@/lib/blog/collection';
import { toHomepagePost } from '@/lib/blog/homepage';

const posts = (await getBlogPosts()).map(toHomepagePost);
---

<Layout
  title="Nikhil Kumar Swain — Frontend Developer & React Engineer"
  description="Nikhil Kumar Swain (zero) is a frontend developer specializing in React, TypeScript, and Next.js — building fast, accessible, production-ready web applications."
  type="profile"
>
  <PortfolioRoot posts={posts} client:only="react" />
</Layout>
