---
import "../styles/global.css";
import content from "../constants/content.json";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageSize?: { width: number; height: number };
  type?: "website" | "profile" | "article";
  noindex?: boolean;
  article?: { publishedTime: string; modifiedTime: string; tags: string[] };
  jsonLd?: Record<string, unknown>[];
  rssUrl?: string;
  dataTheme?: "dark" | "light";
}

const DEFAULT_IMAGE = "/og-image.png";
const IMAGE_TYPES: Record<string, string> = {
  png: "image/png",
  jpg: "image/jpeg",
  jpeg: "image/jpeg",
  webp: "image/webp",
  gif: "image/gif",
};

const {
  title = "Nikhil Kumar Swain — Frontend Developer",
  description = content.about.summary,
  image = DEFAULT_IMAGE,
  imageSize,
  type = "website",
  noindex = false,
  article,
  jsonLd = [],
  rssUrl,
  dataTheme,
} = Astro.props;

const siteURL = Astro.site ?? new URL("https://zerro.dev");
const canonical = new URL(Astro.url.pathname, siteURL).toString();
const ogImage = new URL(image, siteURL).toString();
const ogImageSize = imageSize ?? (image === DEFAULT_IMAGE ? { width: 1200, height: 630 } : undefined);
const ogImageType = IMAGE_TYPES[image.split("?")[0].split(".").pop()?.toLowerCase() ?? ""];
const personName = content.name;
const jobTitle = content.title;
const twitterHandle = "@iamn1khil";
const themeColor = "#0a0a0f";

const socials = [
  content.contact.github,
  content.contact.linkedin,
  content.contact.twitter,
].filter(Boolean);

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteURL.origin}/#person`,
  name: personName,
  alternateName: "zerro",
  url: siteURL.origin,
  image: new URL(DEFAULT_IMAGE, siteURL).toString(),
  jobTitle,
  email: `mailto:${content.contact.email}`,
  description: content.about.summary,
  sameAs: socials,
  knowsAbout: [
    ...content.skills.frontend,
    ...content.skills.backend,
  ],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Graphic Era University",
  },
  worksFor: {
    "@type": "Organization",
    name: "Adstia Pvt. Ltd.",
  },
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: `${personName} — ${jobTitle}`,
  alternateName: "zerro.dev",
  url: siteURL.origin,
  inLanguage: "en",
  author: { "@type": "Person", name: personName },
};
---

<!doctype html>
<html lang="en" data-theme={dataTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={personName} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    {rssUrl && (
      <link rel="alternate" type="application/rss+xml" title="zerro.dev — Blog" href={new URL(rssUrl, siteURL).toString()} />
    )}

    <!-- Icons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={personName} />
    <meta name="application-name" content={personName} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${personName} — Portfolio`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    {ogImageSize && <meta property="og:image:width" content={String(ogImageSize.width)} />}
    {ogImageSize && <meta property="og:image:height" content={String(ogImageSize.height)} />}
    <meta property="og:image:alt" content={`${personName} — ${jobTitle}`} />
    <meta property="og:locale" content="en_US" />
    {type === "profile" && <meta property="profile:username" content="zerro" />}
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article && <meta property="article:author" content={siteURL.origin} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${personName} — ${jobTitle}`} />

    <!-- Discovery -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personJsonLd)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteJsonLd)}
    />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <div>
      <slot />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
