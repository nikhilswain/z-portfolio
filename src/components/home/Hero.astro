---
import CopyEmail from "./CopyEmail.astro";
import { PERSON } from "@/data/profile";
---

<div class="hero">
  <div class="hero__avatar">
    <img class="hero__img" src={PERSON.avatar} alt="Luffy — zero's avatar" width="128" height="128" draggable="false" />
    <p class="hero__shout" aria-hidden="true">gomu gomu no…</p>
  </div>
  <div class="hero__content">
    <p class="hero__eyebrow">aka zero</p>
    <h1 class="hero__name">{PERSON.name}</h1>
    <p class="hero__intro">{PERSON.intro}</p>
    <div class="home__links">
      <CopyEmail />
      <a class="home__link" href={PERSON.github}>GitHub</a>
      <a class="home__link" href={PERSON.linkedin}>LinkedIn</a>
      <a class="home__link" href="/resume/">Resume</a>
    </div>
  </div>
</div>

<script>
  import { initGumGum } from "./gum-gum";
  initGumGum();
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--blog-space-6);
    padding-top: var(--blog-space-5);
  }

  .hero__avatar {
    position: relative;
    width: 96px;
    height: 96px;
  }

  .hero__avatar::before {
    content: "";
    position: absolute;
    inset: 0;
    border: 2px solid var(--blog-accent);
    border-radius: var(--blog-radius);
    translate: 6px 6px;
  }

  .hero__avatar img {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--blog-radius);
  }

  .hero__shout {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 0;
    margin-top: var(--blog-space-2);
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-accent);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 200ms;
    pointer-events: none;
  }

  .hero__shout.is-shouting {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: var(--blog-space-9);
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--blog-space-8);
    }

    .hero__content {
      grid-column: 1;
      grid-row: 1;
    }

    .hero__avatar {
      grid-column: 2;
      grid-row: 1;
      width: 128px;
      height: 128px;
    }
  }

  .hero__eyebrow {
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-fg-muted);
  }

  .hero__name {
    margin: var(--blog-space-4) 0 0;
    font-size: clamp(2.75rem, 2rem + 4vw, 4.5rem);
    line-height: 1.05;
    font-weight: var(--blog-weight-title);
    letter-spacing: -0.02em;
    color: var(--blog-fg-strong);
  }

  .hero__intro {
    margin: var(--blog-space-4) 0 0;
    font-size: var(--blog-text-lead);
    line-height: var(--blog-leading-snug);
    color: var(--blog-fg);
    max-width: 52ch;
  }

  .home__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--blog-space-4);
    margin-top: var(--blog-space-5);
    font-size: var(--blog-text-meta);
  }

  .home__link {
    color: var(--blog-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__avatar::before,
    .hero__avatar img {
      transition: translate 200ms ease-out;
    }

    .hero__avatar:hover::before {
      translate: 10px 10px;
    }

    .hero__avatar:hover img {
      translate: -2px -2px;
    }

    .hero__eyebrow,
    .hero__name,
    .hero__intro,
    .home__links {
      animation: hero-in 500ms ease-out both;
    }

    .hero__eyebrow {
      animation-delay: 0ms;
    }

    .hero__name {
      animation-delay: 60ms;
    }

    .hero__intro {
      animation-delay: 120ms;
    }

    .home__links {
      animation-delay: 180ms;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }
</style>
