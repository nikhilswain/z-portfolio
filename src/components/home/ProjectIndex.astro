---
import { PROJECTS } from "@/data/profile";
import { isListedProject } from "@/lib/blog/projects";

const rest = PROJECTS.filter((project) => isListedProject(project) && project.featured === undefined);
---

<p class="pindex__label">More projects</p>
<ul class="pindex">
  {rest.map((project) => (
    <li>
      {project.link || project.github ? (
        <a class="pindex__row" href={project.link ?? project.github} data-preview={project.image}>
          <img class="pindex__thumb" src={project.image} alt="" width="96" height="54" loading="lazy" />
          <span class="pindex__name">{project.title}</span>
          <span class="pindex__pitch">{project.pitch}</span>
          <span class="pindex__stack">{project.stack.slice(0, 2).join(" · ")}</span>
        </a>
      ) : (
        <div class="pindex__row">
          <img class="pindex__thumb" src={project.image} alt="" width="96" height="54" loading="lazy" />
          <span class="pindex__name">{project.title}</span>
          <span class="pindex__pitch">{project.pitch}</span>
          <span class="pindex__stack">{project.stack.slice(0, 2).join(" · ")}</span>
        </div>
      )}
      {project.link && project.github && (
        <a class="pindex__code" href={project.github}>code ↗</a>
      )}
    </li>
  ))}
</ul>
<img class="pindex__preview" alt="" aria-hidden="true" />

<script>
  const list = document.querySelector(".pindex");
  const preview = document.querySelector(".pindex__preview");

  if (list && preview && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let rafId = 0;

    const step = () => {
      if (reduced) {
        currentX = targetX;
        currentY = targetY;
      } else {
        currentX += (targetX - currentX) * 0.18;
        currentY += (targetY - currentY) * 0.18;
      }
      preview.style.translate = `${currentX}px ${currentY}px`;
      if (!reduced && preview.classList.contains("is-visible")) {
        rafId = requestAnimationFrame(step);
      }
    };

    list.querySelectorAll("[data-preview]").forEach((row) => {
      row.addEventListener("pointerenter", (event) => {
        preview.src = row.getAttribute("data-preview") ?? "";
        targetX = event.clientX + 24;
        targetY = event.clientY - 80;
        currentX = targetX;
        currentY = targetY;
        preview.classList.add("is-visible");
        cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(step);
      });
    });

    list.addEventListener("pointermove", (event) => {
      targetX = event.clientX + 24;
      targetY = event.clientY - 80;
      if (reduced) step();
    });

    list.addEventListener("pointerleave", () => {
      preview.classList.remove("is-visible");
      cancelAnimationFrame(rafId);
    });
  }
</script>

<style>
  .pindex__label {
    margin: var(--blog-space-7) 0 var(--blog-space-4);
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-fg-muted);
  }

  .pindex {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--blog-border);
  }

  .pindex > li {
    border-bottom: 1px solid var(--blog-border);
  }

  .pindex__row {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--blog-space-4);
    align-items: baseline;
    padding: var(--blog-space-3) 0;
    color: inherit;
    text-decoration: none;
  }

  .pindex__thumb {
    grid-row: span 2;
    align-self: center;
    width: 96px;
    height: 54px;
    object-fit: cover;
    border-radius: var(--blog-radius-sm);
  }

  .pindex__name {
    font-size: var(--blog-text-list-title);
    font-weight: var(--blog-weight-heading);
    color: var(--blog-fg-strong);
    transition: color 200ms ease-out;
  }

  .pindex__pitch {
    font-size: var(--blog-text-small);
    color: var(--blog-fg-muted);
  }

  .pindex__stack {
    display: none;
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-fg-muted);
  }

  .pindex__code {
    display: inline-block;
    margin-left: calc(96px + var(--blog-space-4));
    margin-bottom: var(--blog-space-3);
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-fg-muted);
    transition: color 200ms ease-out;
  }

  .pindex__code:hover,
  .pindex__code:focus-visible {
    color: var(--blog-accent);
  }

  .pindex__row:hover .pindex__name,
  .pindex__row:focus-visible .pindex__name {
    color: var(--blog-accent);
  }

  .pindex__preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 18rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--blog-radius);
    pointer-events: none;
    opacity: 0;
    scale: 0.96;
    transition: opacity 200ms ease-out, scale 200ms ease-out;
    z-index: 20;
  }

  .pindex__preview.is-visible {
    opacity: 1;
    scale: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .pindex__thumb {
      display: none;
    }

    .pindex__code {
      margin-left: var(--blog-space-4);
    }
  }

  @media (min-width: 768px) {
    .pindex > li {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: var(--blog-space-5);
      align-items: baseline;
    }

    .pindex__row {
      grid-template-columns: minmax(10rem, 14rem) 1fr auto;
      padding: var(--blog-space-4) 0;
    }

    .pindex__code {
      margin-left: 0;
      margin-bottom: 0;
    }

    .pindex__stack {
      display: block;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .pindex__name {
      transition: color 200ms ease-out, translate 200ms ease-out;
    }

    .pindex__row:hover .pindex__name,
    .pindex__row:focus-visible .pindex__name {
      translate: 6px 0;
    }
  }
</style>
