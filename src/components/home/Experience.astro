---
import { EXPERIENCE, formatRange } from "@/data/profile";
---

<ol class="timeline">
  {EXPERIENCE.map((job) => (
    <li class="timeline__item reveal">
      <p class="timeline__date">{formatRange(job.start, job.end, "now")}</p>
      <div class="timeline__body">
        <h3 class="timeline__heading">
          <strong>{job.company}</strong>
          <span class="timeline__role"> · {job.role}</span>
        </h3>
        <p class="timeline__where">{job.location}</p>
        <ul class="timeline__notes">
          {job.notes.map((note) => (
            <li>{note.text}</li>
          ))}
        </ul>
      </div>
    </li>
  ))}
</ol>
<a class="home__more" href="/resume/">Full resume <span aria-hidden="true">→</span></a>

<style>
  .timeline {
    position: relative;
    margin: 0;
    padding-left: var(--blog-space-6);
    list-style: none;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 0.375rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--blog-border);
  }

  .timeline::after {
    content: "";
    position: absolute;
    left: 0.375rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--blog-accent);
    transform-origin: top;
    display: none;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .timeline::after {
        display: block;
        animation: timeline-draw linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 70%;
      }
    }
  }

  @keyframes timeline-draw {
    from {
      scale: 1 0;
    }
    to {
      scale: 1 1;
    }
  }

  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--blog-space-2);
  }

  .timeline__item + .timeline__item {
    margin-top: var(--blog-space-6);
  }

  .timeline__item::before {
    content: "";
    position: absolute;
    left: calc(-1 * var(--blog-space-6) + 0.375rem);
    top: 0.35rem;
    width: 9px;
    height: 9px;
    border: 2px solid var(--blog-bg);
    border-radius: 50%;
    background: var(--blog-accent);
    translate: -50% 0;
  }

  @media (min-width: 768px) {
    .timeline__item {
      grid-template-columns: 10rem minmax(0, 1fr);
      column-gap: var(--blog-space-6);
    }
  }

  .timeline__date {
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-fg-muted);
  }

  .timeline__heading {
    font-size: var(--blog-text-body);
    font-weight: var(--blog-weight-heading);
    color: var(--blog-fg-strong);
  }

  .timeline__role {
    color: var(--blog-fg-muted);
    font-weight: var(--blog-weight-body);
  }

  .timeline__where {
    margin-top: var(--blog-space-1);
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-fg-muted);
  }

  .timeline__notes {
    margin-top: var(--blog-space-3);
    padding-left: 1.25rem;
    list-style: disc;
    display: grid;
    gap: var(--blog-space-2);
  }
</style>
