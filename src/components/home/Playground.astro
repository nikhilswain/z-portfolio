<div class="field" data-field>
  <p class="field__fallback">A field of dots that react to your pointer, and a place to draw. Needs JavaScript.</p>
</div>
<p class="field__controls">
  <span class="field__hint">move to disturb · drag to draw</span>
  <span aria-hidden="true">·</span>
  <button type="button" data-field-replay>replay</button>
  <span aria-hidden="true">·</span>
  <button type="button" data-field-clear>clear</button>
  <span class="field__pin" hidden>
    <span aria-hidden="true">·</span>
    <button type="button" data-field-pin>pin</button>
  </span>
  <span class="field__wall" hidden>
    <span aria-hidden="true">·</span>
    <a href="/your-doodles/">your wall →</a>
  </span>
  <span class="field__touch" hidden>
    <span aria-hidden="true">·</span>
    <button type="button" data-field-draw aria-pressed="false">draw: off</button>
  </span>
</p>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        const field = entry.target as HTMLElement;
        import("@/components/playground/field").then((mod) => mod.init(field));
      }
    },
    { rootMargin: "200px" },
  );

  document.querySelectorAll("[data-field]").forEach((el) => observer.observe(el));
</script>

<style>
  .field {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    height: clamp(18rem, 42vh, 28rem);
    position: relative;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }

  .field :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  .field__fallback {
    display: grid;
    place-content: center;
    height: 100%;
    padding: var(--blog-space-4);
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-fg-muted);
    text-align: center;
  }

  .field__controls {
    margin-top: var(--blog-space-3);
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-fg-muted);
  }

  .field__controls [aria-hidden="true"] {
    margin-inline: var(--blog-space-2);
  }

  .field__controls button,
  .field__controls a {
    font: inherit;
    color: var(--blog-accent);
    cursor: pointer;
  }

  .field__controls button:hover,
  .field__controls a:hover {
    text-decoration: underline;
  }
</style>
