---
import { PROJECTS } from "@/data/profile";
import { isListedProject } from "@/lib/blog/projects";

const listed = PROJECTS.filter(isListedProject);
const projects = [
  ...listed
    .filter((project) => project.featured !== undefined)
    .sort((a, b) => (a.featured ?? 0) - (b.featured ?? 0)),
  ...listed.filter((project) => project.featured === undefined),
];
const extraCount = Math.max(projects.length - 6, 0);
---

<div class="project-grid">
  {projects.map((project, index) => (
    <article class="card reveal" data-extra={index >= 6 ? "" : undefined}>
      <div class="card__media">
        <img
          src={project.image}
          alt=""
          width="1200"
          height="675"
          loading={index < 2 ? undefined : "lazy"}
        />
      </div>
      <div class="card__body">
        <h3 class="card__title">
          <a href={project.link ?? project.github} class="card__link">
            {project.title}<span aria-hidden="true" class="card__arrow"> ↗</span>
          </a>
        </h3>
        <p class="card__pitch">{project.pitch}</p>
        <p class="card__stack">{project.stack.join(" · ")}</p>
        {project.link && project.github && (
          <p class="card__links"><a href={project.github} class="card__code">Code</a></p>
        )}
      </div>
    </article>
  ))}
</div>
{extraCount > 0 && (
  <button type="button" class="grid-more" hidden>Show all projects ({extraCount} more)</button>
)}

<script>
  const grid = document.querySelector(".project-grid");
  const button = document.querySelector(".grid-more");

  if (grid && button) {
    grid.classList.add("is-collapsed");
    button.hidden = false;
    button.addEventListener("click", () => {
      grid.classList.remove("is-collapsed");
      button.remove();
      (grid.querySelector("[data-extra] .card__link") as HTMLElement | null)?.focus();
    });
  }
</script>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--blog-space-5);
  }

  .is-collapsed [data-extra] {
    display: none;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--blog-border);
    border-radius: var(--blog-radius);
    background: var(--blog-surface);
    transition: border-color 250ms ease-out;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--blog-accent);
  }

  .card__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--blog-space-2);
    padding: var(--blog-space-4);
  }

  .card__title {
    font-size: var(--blog-text-list-title);
    font-weight: var(--blog-weight-heading);
  }

  .card__link {
    color: var(--blog-fg-strong);
    text-decoration: none;
  }

  .card__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card__arrow {
    display: inline-block;
    margin-left: 0.25em;
  }

  .card__pitch {
    font-size: var(--blog-text-small);
    color: var(--blog-fg);
  }

  .card__stack {
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-fg-muted);
  }

  .card__code {
    position: relative;
    z-index: 1;
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-accent);
  }

  .grid-more {
    margin-top: var(--blog-space-5);
    padding: var(--blog-space-2) var(--blog-space-4);
    border: 1px solid var(--blog-border);
    border-radius: var(--blog-radius-sm);
    background: transparent;
    color: var(--blog-fg);
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    cursor: pointer;
  }

  .grid-more:hover {
    border-color: var(--blog-accent);
    color: var(--blog-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card__media img {
      transition: scale 250ms ease-out;
    }

    .card:hover .card__media img,
    .card:focus-within .card__media img {
      scale: 1.03;
    }

    .card__arrow {
      transition: translate 250ms ease-out;
    }

    .card:hover .card__arrow,
    .card:focus-within .card__arrow {
      translate: 2px -2px;
    }
  }
</style>
