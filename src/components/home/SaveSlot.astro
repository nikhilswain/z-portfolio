---
import { EXPERIENCE, PERSON, experienceLevel, formatMonth, timePlayed } from "@/data/profile";

const now = new Date();
const level = experienceLevel(PERSON.careerStart, now);
const played = timePlayed(PERSON.careerStart, now);
const latest = EXPERIENCE[0];
---

<div class="save-slot">
  <img src={PERSON.avatar} alt="" width="64" height="64" class="save-slot__avatar" />
  <p class="save-slot__lines">
    <span>SAVE 01 · ZERO</span>
    <span>Lv.{level} Frontend · {played} played · {PERSON.locationShort}</span>
    <span>Last save: {latest.company} · {formatMonth(latest.start)}</span>
  </p>
</div>

<style>
  .save-slot {
    display: flex;
    align-items: center;
    gap: var(--blog-space-4);
  }

  .save-slot__avatar {
    width: 64px;
    height: 64px;
    image-rendering: auto;
    border: 1px solid var(--blog-border);
    border-radius: var(--blog-radius-sm);
  }

  .save-slot__lines {
    margin: 0;
    display: grid;
    font-family: var(--blog-font-pixel);
    font-size: var(--blog-text-meta);
    color: var(--blog-fg-muted);
  }

  .save-slot__lines span:first-child {
    color: var(--blog-fg-strong);
  }
</style>
