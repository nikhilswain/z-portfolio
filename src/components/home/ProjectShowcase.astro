---
import { PROJECTS } from "@/data/profile";

const featured = PROJECTS.filter((project) => project.featured !== undefined).sort(
  (a, b) => (a.featured ?? 0) - (b.featured ?? 0),
);
---

<div class="showcase">
  {featured.map((project, i) => (
    <article class="work reveal">
      <a class="work__media" href={project.link ?? project.github} tabindex="-1" aria-hidden="true">
        <img
          src={project.image}
          alt=""
          width="1200"
          height="675"
          loading={i < 3 ? undefined : "lazy"}
        />
      </a>
      <h3 class="work__title">
        <a href={project.link ?? project.github}>
          {project.title}<span class="work__arrow" aria-hidden="true">↗</span>
        </a>
      </h3>
      <p class="work__pitch">{project.pitch}</p>
      <p class="work__meta">
        {project.stack.join(" · ")}
        {project.github && project.link && (
          <>
            {" · "}<a href={project.github}>code</a>
          </>
        )}
      </p>
    </article>
  ))}
</div>

<style>
  .showcase {
    display: grid;
    gap: var(--blog-space-7) var(--blog-space-6);
  }

  @media (min-width: 768px) {
    .showcase {
      grid-template-columns: 1fr 1fr;
    }
  }

  .work {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
  }

  .work:first-child {
    grid-column: 1 / -1;
  }

  .work__media {
    display: block;
    overflow: hidden;
    border-radius: var(--blog-radius);
  }

  .work__media img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
  }

  .work:first-child .work__media img {
    aspect-ratio: 21 / 9;
  }

  .work__title {
    margin: var(--blog-space-4) 0 0;
    font-size: var(--blog-text-h3);
    font-weight: var(--blog-weight-heading);
    color: var(--blog-fg-strong);
  }

  .work__title a {
    text-decoration: none;
    background: linear-gradient(var(--blog-accent), var(--blog-accent)) 0 100% / 0 1px no-repeat;
    transition: background-size 250ms ease-out;
  }

  .work__title a:hover,
  .work__title a:focus-visible {
    background-size: 100% 1px;
  }

  .work__arrow {
    display: inline-block;
    margin-left: 0.3em;
  }

  .work__pitch {
    margin: var(--blog-space-2) 0 0;
    color: var(--blog-fg);
  }

  .work__meta {
    margin: var(--blog-space-2) 0 0;
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-fg-muted);
  }

  .work__meta a {
    color: var(--blog-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .work__media img {
      transition: scale 400ms ease-out;
    }

    .work:hover .work__media img,
    .work:focus-within .work__media img {
      scale: 1.04;
    }

    .work__arrow {
      transition: translate 250ms ease-out;
    }

    .work:hover .work__arrow,
    .work:focus-within .work__arrow {
      translate: 2px -2px;
    }
  }
</style>
