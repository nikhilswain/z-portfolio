---
import { PROJECTS } from "@/data/profile";
import { isListedProject } from "@/lib/blog/projects";

const featured = PROJECTS.filter((project) => project.featured !== undefined).sort(
  (a, b) => (a.featured ?? 0) - (b.featured ?? 0),
);
const more = PROJECTS.filter((project) => isListedProject(project) && project.featured === undefined);
---

<h2 class="section-label">Projects</h2>
{featured.map((project) => (
  <article class="project">
    <div class="project__heading">
      <p class="project__index" aria-hidden="true">#{project.featured}</p>
      <h3 class="project__title">
        {project.link || project.github ? (
          <a href={project.link ?? project.github}>{project.title}</a>
        ) : (
          project.title
        )}
      </h3>
    </div>
    {project.image && (
      <img
        src={project.image}
        alt=""
        width="1200"
        height="675"
        loading={project.featured === 0 ? undefined : "lazy"}
      />
    )}
    <p class="project__pitch">{project.pitch}</p>
    <p class="project__stack">{project.stack.join(" · ")}</p>
    {(project.link || project.github) && (
      <p class="project__links">
        {project.link && <a href={project.link}>Live ↗</a>}
        {project.github && <a href={project.github}>Code ↗</a>}
      </p>
    )}
  </article>
))}
<h3 class="section-label">More</h3>
<ul class="more-list">
  {more.map((project) => (
    <li>
      {project.link || project.github ? (
        <a href={project.link ?? project.github}>{project.title}</a>
      ) : (
        project.title
      )}
      {" "}— {project.pitch}
    </li>
  ))}
</ul>

<style>
  .project {
    display: grid;
    gap: var(--blog-space-3);
  }

  .project + .project {
    margin-top: var(--blog-space-6);
  }

  .project__heading {
    display: flex;
    align-items: baseline;
    gap: var(--blog-space-2);
  }

  .project__index {
    font-family: var(--blog-font-pixel);
    font-size: var(--blog-text-meta);
    color: var(--blog-accent);
  }

  .project__title {
    font-size: var(--blog-text-list-title);
    font-weight: var(--blog-weight-heading);
    color: var(--blog-fg-strong);
  }

  .project__title a {
    color: inherit;
    text-decoration: none;
  }

  .project img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--blog-border);
    border-radius: var(--blog-radius);
  }

  @media (min-width: 768px) {
    .project {
      grid-template-columns: 2fr 3fr;
      /* The image spans all text rows; the last row absorbs its extra height so text stays packed. */
      grid-template-rows: auto auto auto 1fr;
      gap: var(--blog-space-2) var(--blog-space-5);
      align-items: start;
    }

    .project__heading {
      grid-column: 2;
      grid-row: 1;
    }

    .project img {
      grid-column: 1;
      grid-row: 1 / span 4;
    }

    .project__pitch,
    .project__stack,
    .project__links {
      grid-column: 2;
    }
  }

  .project__pitch {
    color: var(--blog-fg);
  }

  .project__stack {
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-fg-muted);
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--blog-space-5);
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
  }

  .project__links a {
    color: var(--blog-accent);
  }

  .more-list {
    display: grid;
    gap: var(--blog-space-3);
  }

  .more-list a {
    color: var(--blog-fg-strong);
    text-decoration: none;
  }

  .more-list a:hover {
    color: var(--blog-accent);
  }
</style>
