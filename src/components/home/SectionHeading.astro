---
interface Props {
  eyebrow: string;
  title: string;
  id: string;
}

const { eyebrow, title, id } = Astro.props;
---

<header class="section-heading reveal">
  <div class="section-heading__top">
    <p class="section-heading__eyebrow">{eyebrow}</p>
    <button type="button" class="section-move" data-move aria-label={`Move section: ${title}`} title="Drag to move, or focus and use ↑ ↓">⋮⋮</button>
  </div>
  <h2 id={id}>{title}</h2>
</header>

<style>
  .section-heading {
    margin-bottom: var(--blog-space-6);
  }

  .section-heading__top {
    display: flex;
    align-items: baseline;
    gap: var(--blog-space-3);
  }

  .section-heading__eyebrow {
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    letter-spacing: 0.04em;
    color: var(--blog-accent);
  }

  .section-heading h2 {
    margin: var(--blog-space-2) 0 0;
    font-size: var(--blog-text-h2);
    line-height: var(--blog-leading-heading);
    font-weight: var(--blog-weight-title);
    color: var(--blog-fg-strong);
  }

  .section-move {
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    color: var(--blog-fg-muted);
    background: none;
    border: none;
    padding: 0;
    cursor: grab;
    opacity: 0;
    transition: opacity 200ms ease-out;
  }

  .section-heading:hover .section-move,
  .section-move:focus-visible {
    opacity: 1;
  }

  @media (hover: none) {
    .section-move {
      display: none;
    }
  }
</style>
