---
interface Props {
  eyebrow: string;
  title: string;
  id: string;
}

const { eyebrow, title, id } = Astro.props;
---

<header class="section-heading reveal">
  <p class="section-heading__eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
</header>

<style>
  .section-heading {
    margin-bottom: var(--blog-space-6);
  }

  .section-heading__eyebrow {
    font-family: var(--blog-font-mono);
    font-size: var(--blog-text-meta);
    letter-spacing: 0.04em;
    color: var(--blog-accent);
  }

  .section-heading h2 {
    margin: var(--blog-space-2) 0 0;
    font-size: var(--blog-text-h2);
    line-height: var(--blog-leading-heading);
    font-weight: var(--blog-weight-title);
    color: var(--blog-fg-strong);
  }
</style>
