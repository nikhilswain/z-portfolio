---
import { getBlogPosts } from "@/lib/blog/collection";
import { formatDate, isoDate } from "@/lib/blog/dates";
import { tagSlug } from "@/lib/blog/tags";
import { compareTopLevel } from "@/lib/blog/tree";

const posts = (await getBlogPosts())
  .filter((post) => post.parent === undefined)
  .sort(compareTopLevel)
  .slice(0, 3);
---

<ol class="post-list">
  {posts.map((post) => (
    <li class="post-row">
      <time class="post-row__date" datetime={isoDate(post.publishedAt)}>{formatDate(post.publishedAt)}</time>
      <div>
        <h3 class="post-row__title"><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
        <p class="post-row__desc">{post.description}</p>
        <p class="post-row__meta">
          <span>{post.readingTime} min</span>
          {post.tags.map((tag) => (
            <span class="tag"><span aria-hidden="true">#{tagSlug(tag)}</span><span class="visually-hidden">{tag}</span></span>
          ))}
        </p>
      </div>
    </li>
  ))}
</ol>
<a class="home__more" href="/blog/">All posts <span aria-hidden="true">→</span></a>
