---
import type { MarkdownHeading } from "astro";
import { groupHeadings } from "@/lib/blog/toc";
import TocList from "./TocList.astro";

interface Props {
  headings: MarkdownHeading[];
  variant: "rail" | "inline";
}

const { headings, variant } = Astro.props;
const items = groupHeadings(headings);
---

{variant === "rail" ? (
  <aside class="toc-rail">
    <nav class="toc-rail__inner" aria-labelledby="TocRailTitle">
      <p class="toc-title" id="TocRailTitle">On this page</p>
      <TocList items={items} />
    </nav>
  </aside>
) : (
  <details class="toc-inline">
    <summary>On this page</summary>
    <nav aria-label="On this page">
      <TocList items={items} />
    </nav>
  </details>
)}
