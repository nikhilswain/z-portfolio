<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch theme">
  <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = "zerro-theme";
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  const nextTheme = () => (root.dataset.theme === "dark" ? "light" : "dark");
  const updateLabel = () => button?.setAttribute("aria-label", `Switch to ${nextTheme()} theme`);

  updateLabel();
  button?.addEventListener("click", () => {
    const theme = nextTheme();
    root.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "light" ? "#fbfaf7" : "#0a0a0f");
    try {
      localStorage.setItem(STORAGE_KEY, theme);
    } catch {
      // Storage blocked (private mode): the choice lasts for this page only.
    }
    updateLabel();
  });
</script>
